{
  "manifest_version": 3,
  "name": "CLONE FRAME Framer",
  "version": "1.0.0",
  "description": "Lets the CLONE FRAME in-app browser embed sites that would otherwise block framing, by removing X-Frame-Options / CSP frame-ancestors on FRAMED sub-resources only (never top-level pages).",
  "permissions": ["declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "strip_framing", "enabled": true, "path": "rules.json" }
    ]
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["marker.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["<all_urls>"],
      "js": ["frame-nav.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
